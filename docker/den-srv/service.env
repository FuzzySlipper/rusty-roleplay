RUSTY_CREW_DATA_DIR=/srv/rusty-eva-roleplay
RUSTY_CREW_DEPLOYMENT_ROLE=production
RUSTY_CREW_CONFIG_DIR=/srv/rusty-eva-roleplay/config
RUSTY_CREW_ENGINE_DATA_DIR=/srv/rusty-eva-roleplay/data/engine
RUSTY_CREW_LOG_DIR=/srv/rusty-eva-roleplay/logs
RUSTY_CREW_RUN_DIR=/srv/rusty-eva-roleplay/run
RUSTY_CREW_ARTIFACT_DIR=/srv/rusty-eva-roleplay/artifacts
RUSTY_CREW_BACKUP_DIR=/srv/rusty-eva-roleplay/backups
RUSTY_CREW_STATIC_DIR=/opt/rusty-roleplay/site
RUSTY_CREW_DEFAULT_WORKDIR=/workspace

RUSTY_CREW_ADMIN_HOST=0.0.0.0
RUSTY_CREW_ADMIN_PORT=9347
RUSTY_CREW_ADMIN_ALLOW_LAN=true
RUSTY_CREW_ADMIN_AUTH_MODE=none

RUSTY_CREW_STORAGE_BACKEND=sqlite
RUSTY_CREW_SQLITE_PATH=coordination.sqlite3
RUSTY_CREW_SQLITE_WAL=true
RUSTY_CREW_SQLITE_BUSY_TIMEOUT_MS=5000

RUSTY_CREW_SCHEDULER_TICK_INTERVAL_MS=1000
RUSTY_CREW_WAKE_DISPATCH_INTERVAL_MS=250
