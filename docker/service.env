RUSTY_CREW_DATA_DIR=/home/system/rusty-roleplay-test
RUSTY_CREW_DEPLOYMENT_ROLE=debug
RUSTY_CREW_CONFIG_DIR=/home/system/rusty-roleplay-test/config
RUSTY_CREW_ENGINE_DATA_DIR=/home/system/rusty-roleplay-test/data/engine
RUSTY_CREW_LOG_DIR=/home/system/rusty-roleplay-test/logs
RUSTY_CREW_RUN_DIR=/home/system/rusty-roleplay-test/run
RUSTY_CREW_ARTIFACT_DIR=/home/system/rusty-roleplay-test/artifacts
RUSTY_CREW_BACKUP_DIR=/home/system/rusty-roleplay-test/backups
RUSTY_CREW_STATIC_DIR=/opt/rusty-roleplay/site
RUSTY_CREW_DEFAULT_WORKDIR=/workspace

RUSTY_CREW_ADMIN_HOST=0.0.0.0
RUSTY_CREW_ADMIN_PORT=9347
RUSTY_CREW_ADMIN_ALLOW_LAN=true
RUSTY_CREW_ADMIN_AUTH_MODE=none

RUSTY_CREW_STORAGE_BACKEND=sqlite
RUSTY_CREW_SQLITE_PATH=coordination.sqlite3
RUSTY_CREW_SQLITE_WAL=true
RUSTY_CREW_SQLITE_BUSY_TIMEOUT_MS=5000

RUSTY_CREW_SCHEDULER_TICK_INTERVAL_MS=1000
RUSTY_CREW_WAKE_DISPATCH_INTERVAL_MS=250
